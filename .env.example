# Copy to .env and fill in what you have. Everything is optional.

# Gemini for the "Ask CityCommute" assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay TEST keys for wallet top-ups (Dashboard → Test mode → API keys). Live keys are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret for payment.captured events at /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

PORT=3000
